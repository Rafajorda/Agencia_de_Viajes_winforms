<UserControl x:Class="VistasWPF.UCClients"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VistasWPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#FFF5F5F5" CornerRadius="6" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Gestión de Clientes" FontSize="18" FontWeight="Bold" Foreground="#FF2B2B2B" />

            <!-- Input area: card-like modern look -->
            <Border Grid.Row="1" Background="White" CornerRadius="6" Margin="0,10,0,10" Padding="12" BorderBrush="#FFE6E6E6" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Nombre" FontSize="12" Foreground="#666666" />
                        <TextBox x:Name="TxtNombre" Width="220" Height="28" Background="#FFF8F8F8" BorderBrush="#FFE1E1E1" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Apellidos" FontSize="12" Foreground="#666666" />
                        <TextBox x:Name="TxtApellidos" Width="220" Height="28" Background="#FFF8F8F8" BorderBrush="#FFE1E1E1" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Email" FontSize="12" Foreground="#666666" />
                        <TextBox x:Name="TxtEmail" Width="300" Height="28" Background="#FFF8F8F8" BorderBrush="#FFE1E1E1" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Data grid -->
            <DataGrid x:Name="DgClientes" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" RowBackground="White" AlternatingRowBackground="#FFF7F7F7" GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdCliente}" Width="60" />
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                    <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="*" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnNuevo" Content="Nuevo" Width="100" Click="BtnNuevo_Click" Background="#FF0A7BD2" Foreground="White" Margin="0,0,8,0"/>
                <Button x:Name="BtnGuardar" Content="Guardar" Width="100" Click="BtnGuardar_Click" Background="#FF3BB70F" Foreground="White" Margin="0,0,8,0"/>
                <Button x:Name="BtnEditar" Content="Editar" Width="100" Click="BtnEditar_Click" Background="#FFCEC20E" Foreground="White" Margin="0,0,8,0"/>
                <Button x:Name="BtnEliminar" Content="Eliminar" Width="100" Click="BtnEliminar_Click" Background="#FFE60404" Foreground="White" Margin="0,0,8,0"/>
                <Button x:Name="BtnCancelar" Content="Cancelar" Width="100" Click="BtnCancelar_Click" Background="#FF444444" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

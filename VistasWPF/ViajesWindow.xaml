<Window x:Class="VistasWPF.ViajesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viajes" Height="520" Width="900" Background="#FFB8B5B5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Gestion de Viajes" FontSize="18" FontWeight="Bold" />

        <!-- Inputs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="Destino:" />
                <TextBox x:Name="TxtDestino" Width="300" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="Precio:" />
                <TextBox x:Name="TxtPrecio" Width="120" />
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Plazas:" />
                <TextBox x:Name="TxtPlazas" Width="80" />
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="DgViajes" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="300" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdViaje}" Width="60" />
                <DataGridTextColumn Header="Destino" Binding="{Binding Destino}" Width="*" />
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" Width="120" />
                <DataGridTextColumn Header="Plazas" Binding="{Binding PlazasDisponibles}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons row: left group and close at right -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" HorizontalAlignment="Left">
                <Button x:Name="BtnNuevo" Content="Nuevo" Width="100" Margin="0,0,8,0" Click="BtnNuevo_Click" Background="#FF0A7BD2" Foreground="White" FontWeight="Bold" />
                <Button x:Name="BtnGuardar" Content="Guardar" Width="100" Margin="0,0,8,0" Click="BtnGuardar_Click" Background="#FF3BB70F" Foreground="White" FontWeight="Bold" />
                <Button x:Name="BtnEditar" Content="Editar" Width="100" Margin="0,0,8,0" Click="BtnEditar_Click" Background="#FFCEC20E" Foreground="White" FontWeight="Bold" />
                <Button x:Name="BtnEliminar" Content="Eliminar" Width="100" Margin="0,0,8,0" Click="BtnEliminar_Click" Background="#FFE60404" Foreground="White" FontWeight="Bold" />
                <Button x:Name="BtnCancelar" Content="Cancelar" Width="100" Margin="0,0,8,0" Click="BtnCancelar_Click" Background="#FF373737" Foreground="White" FontWeight="Bold" />
            </StackPanel>

            <Border Grid.Column="1" />

            <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                <Button x:Name="BtnCerrar" Content="Cerrar" Width="100" Click="BtnCerrar_Click" Background="#FF1F1E1E" Foreground="#FFF3EBEB" FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
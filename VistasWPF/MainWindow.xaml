<Window x:Class="VistasWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VistasWPF"
        mc:Ignorable="d"
        Title="Vistas WPF - Menu" Height="383" Width="317">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="TRAVEL-WORLD" FontSize="36" FontWeight="Bold" Margin="0,0,0,10" TextAlignment="Center" Foreground="#FF2980B9"/>

        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300">
            <Button Name="BtnClientes" Content="Clientes" Height="60" Click="BtnClientes_Click" FontSize="20" FontWeight="Bold" Background="#FF3498DB" Margin="0,0,0,10"/>
            <Button Name="BtnViajes" Content="Viajes" Height="60" Click="BtnViajes_Click" FontWeight="Bold" FontSize="20" Background="#FF2ECC71" Margin="0,0,0,10"/>
            <Button Name="BtnReservas" Content="Reservas" Height="62" Click="BtnReservas_Click" FontWeight="Bold" FontSize="20" Background="#FF9B59B6" Margin="0,0,0,10"/>
            <Button Name="BtnSalir" Content="Salir" Height="60" Click="BtnSalir_Click" FontWeight="Bold" FontSize="20" Background="#FFE7493C" Margin="0,0,0,8"/>
        </StackPanel>
    </Grid>
</Window>

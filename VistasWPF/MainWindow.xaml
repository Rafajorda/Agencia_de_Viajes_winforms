<Window x:Class="VistasWPF.MainWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VistasWPF"
        xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        mc:Ignorable="d"
        Title="Travel-world" Height="450" Width="800">
    <Window.Resources>
        <!-- existing styles unchanged -->
        <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#33000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#FF036B3A"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#33000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF036B3A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Top bar: header + menu -->
        <Grid DockPanel.Dock="Top" Width="801" Background="#FF2B2B2B" Height="41" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,12,0">
                <svg:SvgViewbox Width="24" Height="24" Margin="0,0,8,0" Source="pack://application:,,,/VistasWPF;component/Assets/Icons/world.svg" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Travel-World" Foreground="#FF3498DB" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Menu items -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="RbtnViajes" Grid.Column="0" GroupName="Pagina" Style="{StaticResource MenuRadioButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="6,0,6,0" Height="41" VerticalAlignment="Center" Checked="RbtnViajes_Checked">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <svg:SvgViewbox Width="18" Height="18" Margin="0,0,8,0" Source="pack://application:,,,/VistasWPF;component/Assets/Icons/plane.svg" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Viajes" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RbtnClientes" Grid.Column="1" GroupName="Pagina" Style="{StaticResource MenuRadioButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="6,0,6,0" Height="41" VerticalAlignment="Center" Checked="RbtnClientes_Checked">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <svg:SvgViewbox Width="18" Height="18" Margin="0,0,8,0" Source="pack://application:,,,/VistasWPF;component/Assets/Icons/user.svg" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Clientes" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RbtnReservas" Grid.Column="2" GroupName="Pagina" Style="{StaticResource MenuRadioButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="6,0,6,0" Height="41" VerticalAlignment="Center" Checked="RbtnReservas_Checked">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <svg:SvgViewbox Width="18" Height="18" Margin="0,0,8,0" Source="pack://application:,,,/VistasWPF;component/Assets/Icons/booking.svg" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Reservas" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <Button x:Name="BtnSalir" Grid.Column="3" Style="{StaticResource MenuButtonStyle}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="6,0,12,0" Height="41" VerticalAlignment="Center" Click="BtnSalir_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <svg:SvgViewbox Width="18" Height="18" Margin="0,0,8,0" Source="pack://application:,,,/VistasWPF;component/Assets/Icons/exit.svg" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Salir" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <ContentControl x:Name="MainContent" />

    </DockPanel>
</Window>

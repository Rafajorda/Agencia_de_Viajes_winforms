<Window x:Class="VistasWPF.ReservasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservas" Height="600" Width="1000" Background="#FFB8B5B5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Gestion de Reservas" FontSize="18" FontWeight="Bold" Grid.ColumnSpan="2" />

        <!-- New reservation panel -->
        <GroupBox Header="Nueva Reserva" Grid.Row="1" Grid.Column="0" Margin="0,10,10,10" Background="Silver">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Cliente:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="CmbClientes" Grid.Row="0" Grid.Column="1" DisplayMemberPath="Apellidos" SelectedValuePath="IdCliente" />

                <TextBlock Text="Viaje:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,0" />
                <ComboBox x:Name="CmbViajes" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Destino" SelectedValuePath="IdViaje" SelectionChanged="CmbViajes_SelectionChanged" />

                <TextBlock Text="Fecha Reserva:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,0" />
                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1">
                    <DatePicker x:Name="DpFechaReserva" />
                    <TextBlock x:Name="LblPlazasDisponibles" Text="Plazas disponibles: -" Margin="16,4,0,0" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Filters panel -->
        <GroupBox Header="Filtros" Grid.Row="1" Grid.Column="1" Margin="0,10,0,10" Background="Silver">
            <StackPanel Margin="8">
                <Button x:Name="BtnFiltrarPorCliente" Content="Filtrar por Cliente" Click="BtnFiltrarPorCliente_Click" Margin="0,0,0,8" Background="#FF3498DB" Foreground="White" FontWeight="Bold" />
                <Button x:Name="BtnFiltrarPorViaje" Content="Filtrar por Viaje" Click="BtnFiltrarPorViaje_Click" Margin="0,0,0,8" Background="#FF2ECC71" Foreground="White" FontWeight="Bold" />
                <Button x:Name="BtnMostrarTodas" Content="Mostrar Todas" Click="BtnMostrarTodas_Click" Background="#FF9B59B6" Foreground="White" FontWeight="Bold" />
            </StackPanel>
        </GroupBox>

        <!-- Data grid -->
        <DataGrid x:Name="DgReservas" Grid.Row="2" Grid.ColumnSpan="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Reserva" Binding="{Binding IdReserva}" Width="80" />
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*" />
                <DataGridTextColumn Header="Destino" Binding="{Binding Destino}" Width="*" />
                <DataGridTextColumn Header="Precio (EUR)" Binding="{Binding Precio}" Width="120" />
                <DataGridTextColumn Header="Fecha Reserva" Binding="{Binding FechaReserva}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons row: left buttons and close at right -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" HorizontalAlignment="Left">
                <Button x:Name="BtnCrearReserva" Content="Crear Reserva" Width="140" Click="BtnCrearReserva_Click" Margin="0,0,8,0" Background="#FF3BB70F" Foreground="White" FontWeight="Bold" />
                <Button x:Name="BtnCancelarReserva" Content="Cancelar Reserva" Width="160" Click="BtnCancelarReserva_Click" Margin="0,0,8,0" Background="#FFE60404" Foreground="White" FontWeight="Bold" />
                <TextBlock x:Name="TxtTotalReservas" Text="Total de reservas: 0" Margin="8,8,0,0" VerticalAlignment="Center" FontWeight="Bold" />
            </StackPanel>

            <!-- spacer column -->
            <Border Grid.Column="1" />

            <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                <Button x:Name="BtnCerrar" Content="Cerrar" Width="100" Click="BtnCerrar_Click" Background="#FF1F1E1E" Foreground="#FFF3EBEB" FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
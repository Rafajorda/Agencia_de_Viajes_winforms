<Window x:Class="VistasWPF.ClientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clientes" Height="518" Width="900" Foreground="Black" Background="#FFB8B5B5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MinHeight="83" />
            <RowDefinition />
            <RowDefinition Height="Auto" MinHeight="51.04" />
        </Grid.RowDefinitions>

        <TextBlock Text="Gestion de Clientes" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Grid.RowSpan="2" />

        <!-- Inputs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Height="34">
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="Nombre:" />
                <TextBox x:Name="TxtNombre" Width="220" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="Apellidos:" />
                <TextBox x:Name="TxtApellidos" Width="220" />
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Email:" />
                <TextBox x:Name="TxtEmail" Width="300" />
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="DgClientes" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdCliente}" Width="60" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="*" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons row: left group and right group -->
        <Grid Grid.Row="3" Margin="0,1,0,-1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" HorizontalAlignment="Left">
                <Button x:Name="BtnNuevo" Content="Nuevo" Width="100" Margin="0,0,8,0" Click="BtnNuevo_Click" FontSize="14" FontWeight="Bold" Background="#FF0A7BD2"  VerticalAlignment="Center" Foreground="White" />
                <Button x:Name="BtnGuardar" Content="Guardar" Width="100" Margin="0,0,8,0" Click="BtnGuardar_Click" FontSize="14" FontWeight="Bold" Background="#FF3BB70F"  VerticalAlignment="Center" Foreground="#FFF4F4F4" />
                <Button x:Name="BtnEditar" Content="Editar" Width="100" Margin="0,0,8,0" Click="BtnEditar_Click" FontSize="14" FontWeight="Bold" Background="#FFCEC20E"  VerticalAlignment="Center" Foreground="#FFFDFDFD" />
                <Button x:Name="BtnEliminar" Content="Eliminar" Width="100" Margin="0,0,8,0" Click="BtnEliminar_Click" FontSize="14" FontWeight="Bold" Background="#FFE60404"  VerticalAlignment="Center" Foreground="#FFF6F6F6" />
            </StackPanel>

            <!-- spacer in middle (empty column) -->

            <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                <Button x:Name="BtnCancelar" Content="Cancelar" Width="100" Click="BtnCancelar_Click" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF373737"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#FF2E2E2E"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#FF6E6E6E"/>
                                    <Setter Property="Foreground" Value="#FFBBBBBB"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnCerrar" Content="Cerrar" Click="BtnCerrar_Click" Background="#FF1F1E1E" Width="100" FontSize="14" FontWeight="Bold" Foreground="#FFF3EBEB" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
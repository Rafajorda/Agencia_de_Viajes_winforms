<UserControl x:Class="VistasWPF.UCTravel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#FFF5F5F5" CornerRadius="6" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Gestion de Viajes" FontSize="18" FontWeight="Bold" Foreground="#FF2B2B2B" />

            <!-- Inputs -->
            <Border Grid.Row="1" Background="White" CornerRadius="6" Margin="0,10,0,10" Padding="12" BorderBrush="#FFE6E6E6" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Destino" FontSize="12" Foreground="#666666" />
                        <TextBox x:Name="TxtDestino" Width="300" Height="28" Background="#FFF8F8F8" BorderBrush="#FFE1E1E1" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Precio" FontSize="12" Foreground="#666666" />
                        <TextBox x:Name="TxtPrecio" Width="120" Height="28" Background="#FFF8F8F8" BorderBrush="#FFE1E1E1" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Plazas" FontSize="12" Foreground="#666666" />
                        <TextBox x:Name="TxtPlazas" Width="80" Height="28" Background="#FFF8F8F8" BorderBrush="#FFE1E1E1" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid x:Name="DgViajes" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" RowBackground="White" AlternatingRowBackground="#FFF7F7F7" GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdViaje}" Width="60" />
                    <DataGridTextColumn Header="Destino" Binding="{Binding Destino}" Width="*" />
                    <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" Width="120" />
                    <DataGridTextColumn Header="Plazas" Binding="{Binding PlazasDisponibles}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnNuevo" Content="Nuevo" Width="100" Click="BtnNuevo_Click" Background="#FF0A7BD2" Foreground="White" Margin="0,0,8,0"/>
                <Button x:Name="BtnGuardar" Content="Guardar" Width="100" Click="BtnGuardar_Click" Background="#FF3BB70F" Foreground="White" Margin="0,0,8,0"/>
                <Button x:Name="BtnEditar" Content="Editar" Width="100" Click="BtnEditar_Click" Background="#FFCEC20E" Foreground="White" Margin="0,0,8,0"/>
                <Button x:Name="BtnEliminar" Content="Eliminar" Width="100" Click="BtnEliminar_Click" Background="#FFE60404" Foreground="White" Margin="0,0,8,0"/>
                <Button x:Name="BtnCancelar" Content="Cancelar" Width="100" Click="BtnCancelar_Click" Background="#FF444444" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>